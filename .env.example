# ==============================================================================
# AI-Powered Restaurant Recommendation System - Configuration Template
# ==============================================================================
# Copy this file to .env and fill in the values for your environment.
# DO NOT commit the .env file with actual credentials to version control.

# ------------------------------------------------------------------------------
# Application & Environment Settings
# ------------------------------------------------------------------------------
APP_ENV=development                    # development | staging | production | test
DEBUG=true
LOG_LEVEL=INFO                         # DEBUG | INFO | WARNING | ERROR | CRITICAL
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:8501", "http://127.0.0.1:8501"]

# ------------------------------------------------------------------------------
# Dataset & Ingestion Configuration
# ------------------------------------------------------------------------------
DATASET_NAME=ManikaSaini/zomato-restaurant-recommendation
DATASET_REVISION=main
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
SQLITE_PATH=data/processed/restaurants.db
PARQUET_PATH=data/processed/restaurants.parquet

# ------------------------------------------------------------------------------
# Retrieval & Shortlisting Settings
# ------------------------------------------------------------------------------
SHORTLIST_SIZE=12                      # Number of candidate restaurants sent to LLM (compact for token budget)
DEFAULT_TOP_N=5                        # Default number of final recommendations
MAX_TOP_N=20                           # Maximum allowed top_n requested by client

# ------------------------------------------------------------------------------
# LLM Provider Configuration (Groq: openai/gpt-oss-120b)
# ------------------------------------------------------------------------------
# Supported providers: groq | openai | gemini | ollama | mock
LLM_PROVIDER=groq
# Groq model options: openai/gpt-oss-120b | qwen/qwen3.6-27b
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=your_groq_api_key_here
LLM_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_TEMPERATURE=0.2                    # Low temperature for deterministic & grounded reasoning
LLM_MAX_TOKENS=600                     # Capped token completion budget
LLM_TIMEOUT_SECONDS=10.0
LLM_MAX_RETRIES=2

# ------------------------------------------------------------------------------
# Groq Rate Limits & Quota Protection (openai/gpt-oss-120b)
# ------------------------------------------------------------------------------
RATE_LIMIT_RPM=30                      # Max requests per minute (RPM)
RATE_LIMIT_RPD=1000                    # Max requests per day (RPD)
RATE_LIMIT_TPM=8000                    # Max tokens per minute (TPM)
RATE_LIMIT_TPD=200000                  # Max tokens per day (TPD)

# Ollama-specific (only needed if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# ------------------------------------------------------------------------------
# Frontend (Streamlit) Configuration
# ------------------------------------------------------------------------------
BACKEND_API_URL=http://localhost:8000
